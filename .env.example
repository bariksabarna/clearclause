# ── Server ────────────────────────────────────────────────────────────────
# AI provider key — server-side only. NEVER commit the real value.
GEMINI_API_KEY=
# Gemini model id locked at build time (default: gemini-3.6-flash).
GEMINI_MODEL=gemini-3.6-flash
PORT=8080
NODE_ENV=development

# ── Security ──────────────────────────────────────────────────────────────
# Comma-separated CORS whitelist. No wildcard `*`.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Set true when running behind a reverse proxy / load balancer so rate limits
# key on the real client IP (X-Forwarded-For) instead of the proxy's address.
TRUST_PROXY=false

# ── Rate limiting (seconds / requests per window) ─────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_GLOBAL=200
RATE_LIMIT_MAX_AI=20

# ── Uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=5
MAX_EXTRACTED_CHARS=2000000